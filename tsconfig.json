{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "lib/types",
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/*": [
        "stubs/@deepseek-ai/*"
      ],
      "ssh2": [
        "stubs/ssh2"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src"
  ]
}